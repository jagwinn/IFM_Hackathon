# Generate a value with: python3 -c 'import secrets; print(secrets.token_hex(32))'
WEBUI_SECRET_KEY=
# Set false only for a fresh, localhost-only single-user demo volume.
WEBUI_AUTH=true
# Use simulated for the offline fixture or live for real requests.
RELAY_PROVIDER=simulated
CLOUD_BASE_URL=https://api.ifm.ai/v1
CLOUD_MODEL=IFM/K2-Horizon-375B-A23B
CLOUD_API_KEY=
# The live Compose override uses its local-model service automatically.
LOCAL_BASE_URL=http://local-model:8080/v1
LOCAL_MODEL=IFM/K2-Horizon-0.9B
# Absolute path to IFM's downloaded K2-Horizon-1B-BF16.gguf (0.9B model).
LOCAL_MODEL_PATH=
# Path to the 4B GGUF from IFM/K2-Horizon-3.7B-GGUF (quantize K2-Horizon-4B-BF16.gguf to fit 8 GB GPUs).
LOCAL_MODEL_4B_PATH=
# GPU compose only: host GPU index for each model (nvidia-smi -L). Defaults to 0.
LOCAL_MODEL_GPU=
MID_MODEL_GPU=
